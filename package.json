{
  "name": "derive-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild derive/static/editor-entry.js --bundle --format=esm --minify --outfile=derive/static/vendor/editor.js && esbuild derive/static/math-entry.js --bundle --format=esm --minify --outfile=derive/static/vendor/math.js",
    "check": "for f in derive/static/*.js; do node --check $f || exit 1; done"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "esbuild": "0.25.11"
  },
  "overrides": {
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  }
}
